{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/louisbranch/ritual/ritual.schema.json",
  "title": "Ritual",
  "type": "object",
  "required": ["name", "start", "end", "repeat"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "start": { "$ref": "#/$defs/time" },
    "end": { "$ref": "#/$defs/time" },
    "repeat": {
      "oneOf": [
        { "const": "daily" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/weekday" }
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "time": {
      "type": "string",
      "description": "Time of day as HH:MM in 24-hour form, e.g. '06:30', '21:00'.",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "weekday": {
      "type": "string",
      "description": "Weekday name in 2-letter, 3-letter, or full form (case-insensitive).",
      "pattern": "^([Ss][Uu]([Nn]([Dd][Aa][Yy])?)?|[Mm][Oo]([Nn]([Dd][Aa][Yy])?)?|[Tt][Uu]([Ee]([Ss][Dd][Aa][Yy])?)?|[Ww][Ee]([Dd]([Nn][Ee][Ss][Dd][Aa][Yy])?)?|[Tt][Hh]([Uu]([Rr][Ss][Dd][Aa][Yy])?)?|[Ff][Rr]([Ii]([Dd][Aa][Yy])?)?|[Ss][Aa]([Tt]([Uu][Rr][Dd][Aa][Yy])?)?)$"
    }
  }
}
